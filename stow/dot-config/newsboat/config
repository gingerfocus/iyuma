# show-read-feeds no
auto-reload no
# confirm-mark-feed-read no

# interface
# text-width 0
# max-items 10

# external-url-viewer "urlscan -dc -r linkhandler {}"

# browser "zen %u"
# browser lynx
# save-path ~/tmp
notify-program notify-send
# player mpv

bind-key SPACE macro-prefix
macro c set browser "wl-copy %u" ; open-in-browser ; set browser zen

# key bindings
bind-key j down
bind-key k up
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key G end
bind-key g home
bind-key d pagedown
bind-key u pageup
bind-key l open
bind-key h quit
bind-key a toggle-article-read
bind-key n next-unread
bind-key N prev-unread
bind-key U show-urls

## interface colours


# color listnormal cyan default
# color listfocus black yellow standout bold
# color listnormal_unread blue default
# color listfocus_unread yellow default bold
# color info red black bold
# color article white default bold

color info color11 black
color listfocus color7 color8
color listfocus_unread color11 color8
color listnormal color7 default
color listnormal_unread color13 default
